                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": [\n    {\n      \"erp\": \"<string>\",\n      \"erpVersion\": \"<string>\",\n      \"connectorVersion\": \"<string>\",\n      \"level\": \"<string>\",\n      \"code\": \"<string>\",\n      \"message\": \"<string>\"\n    },\n    {\n      \"erp\": \"<string>\",\n      \"erpVersion\": \"<string>\",\n      \"connectorVersion\": \"<string>\",\n      \"level\": \"<string>\",\n      \"code\": \"<string>\",\n      \"message\": \"<string>\"\n    }\n  ]\n}",
