{
  "opencollection": "1.0.0",
  "info": {
    "name": "Embat AccountingAccounts Categories API",
    "version": "2.120.3"
  },
  "items": [
    {
      "info": {
        "name": "Categories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List categories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/categories/:companyId",
            "params": [
              {
                "name": "companyId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns every category configured for the company, both top-level and child categories. The list is not paginated. Categories are created and managed in the Embat application; this API only reads them."
        },
        {
          "info": {
            "name": "Retrieve category",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/categories/:companyId/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "companyId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a single category by its Embat `id`."
        }
      ]
    }
  ],
  "bundled": true
}