{
  "opencollection": "1.0.0",
  "info": {
    "name": "Embat AccountingAccounts Companies API",
    "version": "2.120.3"
  },
  "items": [
    {
      "info": {
        "name": "Companies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List user companies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/companies",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the companies your credentials have access to. Use the returned `id` as the `companyId` path parameter required by every other endpoint in this API."
        },
        {
          "info": {
            "name": "Retrieve company",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/companies/:companyId",
            "params": [
              {
                "name": "companyId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the detail of a company: legal name, administrative contact, tags and configuration (e.g. accounting currency)."
        },
        {
          "info": {
            "name": "List company users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/companies/:companyId/users",
            "params": [
              {
                "name": "companyId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the users with access to the company identified by `companyId`. The returned `id` matches the `userId` recorded on entities created manually in Embat (e.g. payments)."
        }
      ]
    }
  ],
  "bundled": true
}